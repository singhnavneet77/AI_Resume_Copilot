# Copy this file to backend/.env and fill in real values.
# Never commit backend/.env (with real secrets) to source control.

# --- Database -----------------------------------------------------------
# PostgreSQL (recommended, used by docker-compose.yml out of the box):
DATABASE_URL=postgresql+psycopg2://resume_admin:resume_admin_pw@localhost:5432/resume_copilot

# SQLite fallback (zero setup, NOT recommended beyond local demos):
# DATABASE_URL=sqlite:///./resume_copilot.db

# --- Auth -----------------------------------------------------------------
# Generate your own with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_long_random_value

# --- LLM providers (optional system-wide fallback) -------------------------
# Individual users can also set their OWN keys from the in-app Settings page;
# those are stored per-user in the database and take priority over these.
GEMINI_API_KEY=
OPENAI_API_KEY=
PREFERRED_PROVIDER=gemini

# --- Vector search ----------------------------------------------------------
QDRANT_PATH=qdrant_local_storage
